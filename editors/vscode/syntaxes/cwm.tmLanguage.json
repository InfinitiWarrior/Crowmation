{
  "name": "Crowmation",
  "scopeName": "source.cwm",
  "patterns": [
    { "name": "comment.line.double-slash.cwm", "match": "//.*$" },
    {
      "name": "string.quoted.double.cwm",
      "begin": "\"", "end": "\"",
      "patterns": [{ "name": "constant.character.escape.cwm", "match": "\\\\[\\\\\"n#]" }]
    },
    { "name": "constant.other.color.cwm", "match": "#\\h{6}(\\h{2})?\\b" },
    { "name": "constant.numeric.cwm", "match": "\\b\\d+(\\.\\d+)?(s|ms|deg|rad)?\\b" },
    { "name": "keyword.control.cwm", "match": "\\b(scene|component|import|let|repeat|as|wait|at|after|with)\\b" },
    { "name": "keyword.other.setting.cwm", "match": "\\b(size|fps|background|duration)\\b" },
    { "name": "storage.type.object.cwm", "match": "\\b(rect|circle|arrow|line|image|text|code|math|model|camera)\\b" },
    { "name": "entity.name.function.action.cwm", "match": "\\b(move|rotate|scale|fade|fade_in|fade_out|color|orbit|tilt|explode)\\b" },
    { "name": "variable.parameter.property.cwm", "match": "\\b(to|by|ease|from|width|head|radius|corner|outline|outline_width|opacity|rotation|lang|content|fov|z|layer|pin)\\b" },
    { "name": "constant.language.cwm", "match": "\\b(overlay|world|linear|in|out|in_out)\\b" }
  ]
}
