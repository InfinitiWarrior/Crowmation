{
  "name": "crowmation",
  "displayName": "Crowmation",
  "description": "Crowmation scene files (.cwm): highlighting, errors as you type, completion and hover docs",
  "version": "0.1.0",
  "publisher": "crowmation",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "cwm",
        "aliases": ["Crowmation", "cwm"],
        "extensions": [".cwm"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "cwm", "scopeName": "source.cwm", "path": "./syntaxes/cwm.tmLanguage.json" }
    ],
    "configuration": {
      "title": "Crowmation",
      "properties": {
        "crowmation.path": {
          "type": "string",
          "default": "crowmation",
          "description": "Path to the crowmation binary (runs `crowmation lsp`)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
